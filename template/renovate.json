{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 10,
  "labels": [
    "dependencies"
  ],
  "reviewers": [
    "brpaz"
  ],
  "flux": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "kubernetes": {
    "fileMatch": [
      "^infrastructure(/.*)?/.*\\.yaml$",
      "^apps(/.*)?/.*\\.yaml$",
      "^clusters(/.*)?/.*\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "Group and automerge non-major updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major updates",
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}