{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeMinor",
    ":prConcurrentLimit10"
  ],
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^infrastructure(/.*)?/.*\\.yaml$/",
      "/^apps(/.*)?/.*\\.yaml$/",
      "/^clusters(/.*)?/.*\\.yaml$/"
    ]
  },
  "labels": ["dependencies"],
  "reviewers": ["brpaz"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github actions"
    }
  ]
}
